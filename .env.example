# PostgreSQL connection string. Replace user/password with real credentials.
#   Local dev : your local "postgres-db" container, dedicated "revu" database.
#   Production: set Railway's DATABASE_URL in the Vercel environment variables.
# Only this value changes between local and production — the code is identical.
DATABASE_URL=postgresql://user:password@localhost:5432/revu

# Secret used to sign JWT auth tokens — use a long random value in production.
NUXT_JWT_SECRET=change_me_in_production

# SMTP credentials for transactional emails (not used yet).
NUXT_MAIL_USER=
NUXT_MAIL_PASS=
