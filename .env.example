# PostgreSQL connection string. Replace user/password with real credentials.
#   Local dev : your local "postgres-db" container, dedicated "revu" database.
#   Production: set Railway's DATABASE_URL in the Vercel environment variables.
# Only this value changes between local and production — the code is identical.
DATABASE_URL=postgresql://user:password@localhost:5432/revu

# Optional: max DB connections per instance (default 5). Lower it if your managed
# Postgres has few connection slots and you run several serverless instances.
DATABASE_POOL_MAX=5

# Secret used to sign JWT auth tokens — use a long random value in production.
NUXT_JWT_SECRET=change_me_in_production

# SMTP settings for transactional emails (password-reset links).
# Gmail example: host smtp.gmail.com, port 465, user = your address,
# pass = a Google "app password" (not your normal password).
# Leave NUXT_MAIL_HOST empty to disable sending — the reset link is then logged
# to the server console instead (handy in local development).
NUXT_MAIL_HOST=
NUXT_MAIL_PORT=465
NUXT_MAIL_USER=
NUXT_MAIL_PASS=
# Optional "From" address shown to recipients; defaults to NUXT_MAIL_USER.
NUXT_MAIL_FROM=

# Credentials of admin account
ADMIN_MAIL=admin@admin.fr
ADMIN_PASSWORD=admin
